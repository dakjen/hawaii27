# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

# PINs are now validated server-side (NEVER use NEXT_PUBLIC_* for these)
BEN_PIN=xxxx
SENDER_PIN=xxxx

# Random secret for signing the auth cookie (any 32+ char random string)
# Generate one: openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-random-32-plus-char-string

# Your password for the send note API
SENDER_PASSWORD=your_password_here

# Neon database connection string
# Get this from neon.tech -> your project -> Connection Details
NEON_DATABASE_URL=postgresql://user:password@host/dbname

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron secret (Vercel Cron uses this to authenticate scheduled calls)
CRON_SECRET=
